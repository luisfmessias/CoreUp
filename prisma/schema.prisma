generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  heightCm     Float?
  weightKg     Float?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     AuthSession[]
  workouts     Workout[]
  history      WorkoutLog[]
  bodyMetrics  BodyMetric[]
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workout {
  id          String            @id @default(cuid())
  userId      String
  title       String
  weekday     Weekday?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
  history     WorkoutLog[]
}

model WorkoutExercise {
  id            String  @id @default(cuid())
  workoutId     String
  exerciseId    Int
  order         Int
  sets          Int?
  reps          String?
  restSeconds   Int?
  loadKg        Float?
  notes         String?
  workout       Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String
  workoutId   String?
  performedAt DateTime @default(now())
  durationMin Int?
  notes       String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout     Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  sets        LogSet[]
}

model LogSet {
  id          String     @id @default(cuid())
  logId       String
  exerciseId  Int
  setNumber   Int
  reps        Int?
  loadKg      Float?
  done        Boolean    @default(true)
  log         WorkoutLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String
  weightKg  Float?
  heightCm  Float?
  bodyFat   Float?
  measuredAt DateTime @default(now())
  notes     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
