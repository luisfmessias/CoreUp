generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String               @unique
  passwordHash      String
  heightCm          Float?
  weightKg          Float?
  preferences       Json?
  privacyAcceptedAt DateTime?
  accountType       AccountType          @default(USER)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          AuthSession[]
  workouts          Workout[]
  history           WorkoutLog[]
  bodyMetrics       BodyMetric[]
  professional      ProfessionalProfile?
  workoutReviews    WorkoutReview[]
}

// Sem integracao com o CREF: todo cadastro nasce PENDING e so muda apos conferencia manual.
model ProfessionalProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  crefNumber         String
  crefState          String
  specialty          String
  education          String
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([crefNumber, crefState])
}

model WorkoutReview {
  id              String   @id @default(cuid())
  professionalId  String
  workoutKey      String
  rating          Int
  comment         String
  strengths       String[]
  limitations     String[]
  recommendations String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  professional    User     @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, workoutKey])
  @@index([workoutKey])
}

enum AccountType {
  USER
  PROFESSIONAL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workout {
  id          String            @id @default(cuid())
  userId      String
  title       String
  weekday     Weekday?
  intensity   String?
  durationMin Int?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
  history     WorkoutLog[]

  @@index([userId, weekday])
}

model WorkoutExercise {
  id          String  @id @default(cuid())
  workoutId   String
  exerciseId  Int
  order       Int
  sets        Int?
  reps        String?
  restSeconds Int?
  loadKg      Float?
  notes       String?
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String
  workoutId   String?
  performedAt DateTime @default(now())
  durationMin Int?
  notes       String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout     Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  sets        LogSet[]

  @@index([userId, performedAt])
}

model LogSet {
  id         String     @id @default(cuid())
  logId      String
  exerciseId Int
  setNumber  Int
  reps       Int?
  loadKg     Float?
  done       Boolean    @default(true)
  log        WorkoutLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
}

model BodyMetric {
  id         String   @id @default(cuid())
  userId     String
  weightKg   Float?
  heightCm   Float?
  bodyFat    Float?
  measuredAt DateTime @default(now())
  notes      String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
}

// No banco porque, na Vercel, um contador em memoria nao e compartilhado entre instancias.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
